# Apache / cPanel hosting (Bluehost and similar)
# Every Aviac rule below applies only to aviac.in (and www.aviac.in), so other sites that share this folder or live in
# folders inside it are left exactly as they were. To host on another domain, change "aviac\.in" in the lines below.
DirectoryIndex index.html

# file types some hosts do not know yet (harmless for any site)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType model/gltf-binary .glb
  AddType application/wasm .wasm
</IfModule>

<If "%{HTTP_HOST} =~ /(^|\.)aviac\.in$/">
  ErrorDocument 404 /404.html
</If>

# always https on aviac.in
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} (^|\.)aviac\.in$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://formsubmit.co; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  Header always set X-Content-Type-Options "nosniff" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  Header always set X-Frame-Options "SAMEORIGIN" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  Header always set Referrer-Policy "strict-origin-when-cross-origin" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  Header always set Cross-Origin-Opener-Policy "same-origin" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/"
  # pages always check for a new version; images and films keep a day; scripts, styles and 3D models carry a version in
  # their URL, so they keep a year
  Header set Cache-Control "public, max-age=0, must-revalidate" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/ && %{REQUEST_URI} =~ m#(/|\.html)$#"
  Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/ && %{REQUEST_URI} =~ /\.(jpe?g|png|webp|svg|mp4|txt|json)$/"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{HTTP_HOST} =~ /(^|\.)aviac\.in$/ && %{REQUEST_URI} =~ /\.(css|js|bin|glb)$/"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript text/plain image/svg+xml application/json application/octet-stream model/gltf-binary
</IfModule>
