{
 "trailingSlash": true,
 "cleanUrls": true,
 "headers": [
  {
   "source": "/assets/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/assets/film/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/models/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400, stale-while-revalidate=604800"
    }
   ]
  },
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/chunks/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(site.css|site.js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(viewer.js|flight.js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}